# 4cc Blender Starter Pack: external tooling (pes-fmdl addon), not ours
/4cc Blender Starter Pack/

# Derived geometry caches: built from the .ase on first load, rebuilt
# whenever it changes. Never a source - see src/loaders/asecache.hpp.
*.geomcache

# Imported PES/4cc assets. None of this belongs in the repository - it is produced
# from a user's own copy of PES 2021 by tools/pes21_import (see docs/ASSETS.md).
data/media/objects/stadiums/pes_st*/
data/media/objects/stadiums/adboards/
data/media/textures/adboards/ad_4cc_*.png
# PES's own hoardings, imported from dt30's bg/common/bill as <set>__<face>.png
data/media/textures/adboards/*__*.png
data/media/textures/stadium/pes_*.png
data/media/textures/stadium/goalnetting_pes.png
data/media/textures/pitch/pes/
data/media/textures/crowd/banners/
data/media/textures/sky/pes_*.png
data/media/textures/lut/

# Source packs, unpacked in the working tree while importing. These are Konami's
# and the pack authors' work: extracted 4cc stadium packs ("<slot> - <name>/"),
# a stadiums/ folder of them, and anything unpacked beside them. Ignored so no
# amount of "git add -A" can put them in the repository - see docs/ASSETS.md.
/[0-9][0-9][0-9] - *ered/
/[0-9][0-9][0-9] - */
/stadiums/
/pes_common_extract/
/pes_lut_extract/

