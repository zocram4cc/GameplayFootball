<%# admin/partials/user_management_content.ejs %>

<h2>Active Registration Links</h2>
<ul>
    <% tokens.forEach(token => { %>
        <li>
            <%= token.username %> (<%= token.roles.map(r => r.name).join(', ') %>) - <%= baseUrl %>/register?token=<%= token.token %>
            <button hx-delete="/admin/registration-tokens/<%= token.id %>" hx-confirm="Are you sure?" hx-target="#user-management-content" hx-swap="innerHTML">Delete</button>
        </li>
    <% }) %>
</ul>

<h2>Users</h2>
<table>
    <thead>
        <tr>
            <th>Username</th>
            <th>Roles</th>
            <th>Team</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% users.forEach(user => { %>
            <tr>
                <td><%= user.username %></td>
                <td><%= user.roles.map(r => r.name).join(', ') %></td>
                <td><%= user.team ? user.team.name : 'N/A' %></td>
                <td>
                    <a href="/admin/users/<%= user.id %>/edit" class="button">Edit</a>
                    <button hx-delete="/admin/users/<%= user.id %>" hx-confirm="Are you sure you want to delete <%= user.username %>?" hx-target="#user-management-content" hx-swap="innerHTML">Delete</button>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>


<h2>Teams</h2>
<ul>
    <% teams.forEach(team => { %>
        <li>
            <%= team.name %>
            <button hx-delete="/admin/teams/<%= team.id %>" hx-confirm="Are you sure you want to delete team <%= team.name %>? This will also delete all managers associated with this team." hx-target="#user-management-content" hx-swap="innerHTML">Delete</button>
        </li>
    <% }) %>
</ul>